{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory Lane",
  "version": "0.1.0",
  "identifier": "com.santamatronic.memorylane",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "npm run build:ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "create": false, "title": "Memory Lane — Desktop Draft", "width": 540, "height": 900, "minWidth": 340, "minHeight": 500, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
