[Unit]
Description=Check for a signed Memory Lane application update
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/memory-lane-updater.json

[Service]
Type=oneshot
ExecStart=/usr/local/bin/memory-lane check
TimeoutStartSec=180
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/memory-lane
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
